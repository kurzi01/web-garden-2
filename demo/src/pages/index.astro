---
import '../styles/moj-ogrod-planner.scss';

const nav = [
  ['Plan ogrodu', 'aktywny'],
  ['Rabaty i sektory', '6'],
  ['Rośliny', '210'],
  ['Mój ogród', '56'],
  ['Zakupy', '12'],
  ['Studio', ''],
  ['Analiza', ''],
];
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Mój Ogród — Planner Pro</title>
    <meta name="description" content="Desktopowy planer ogrodu: rabaty, rośliny, rozstaw, sezonowość, zakupy i analiza kompozycji." />
  </head>
  <body>
    <div class="planner-shell">
      <header class="planner-topbar">
        <div class="brand-block">
          <div class="brand-mark">MO</div>
          <div class="brand-copy"><strong>Mój Ogród</strong><span>Planner Pro</span></div>
        </div>

        <div class="project-title">
          <span class="status-dot"></span>
          <strong>Ogród domowy · Rzeszów</strong>
          <span class="badge" data-save-badge>zapisano</span>
        </div>

        <div class="top-actions">
          <button class="icon-btn" title="Przywróć projekt" data-reset-project>↺</button>
          <button class="ghost-btn">Import z mobile</button>
          <button class="primary-btn">Eksport projektu</button>
        </div>
      </header>

      <div class="planner-body">
        <aside class="sidebar">
          <div class="section-kicker">Projekt</div>
          {nav.slice(0, 4).map(([label, count], i) => (
            <button class:list={['nav-item', { active: i === 0 }]}>
              <span>{label}</span>{count && <small>{count}</small>}
            </button>
          ))}

          <div class="section-kicker">Planowanie</div>
          {nav.slice(4).map(([label, count]) => (
            <button class="nav-item"><span>{label}</span>{count && <small>{count}</small>}</button>
          ))}

          <div class="section-kicker">Warstwy</div>
          <button class="nav-item"><span>Rośliny posadzone</span><small>✓</small></button>
          <button class="nav-item"><span>Rośliny planowane</span><small>✓</small></button>
          <button class="nav-item"><span>Rozstaw i kolizje</span><small>✓</small></button>
          <button class="nav-item"><span>Sezon / wzrost</span><small>2027</small></button>
        </aside>

        <main class="workspace">
          <div class="workspace-toolbar">
            <div class="tool-group">
              <button class="ghost-btn active-tool">Wybierz</button>
              <button class="ghost-btn">Dodaj rabatę</button>
              <button class="ghost-btn" data-add-plant>Dodaj roślinę</button>
              <button class="ghost-btn">Zmierz</button>
              <button class="ghost-btn" data-auto-layout>Auto-layout</button>
            </div>
            <div class="tool-group">
              <button class="ghost-btn" data-zoom-out>−</button>
              <button class="ghost-btn" data-zoom-reset data-zoom-label>100%</button>
              <button class="ghost-btn" data-zoom-in>+</button>
              <button class="ghost-btn" data-fit>Dopasuj</button>
            </div>
          </div>

          <section class="canvas" aria-label="Plan ogrodu" data-planner-canvas>
            <div class="planner-scene" data-planner-scene>
              <div class="garden-boundary"></div>
              <button class="bed bed-a" data-bed="front" aria-label="Rabata frontowa"></button>
              <button class="bed bed-b" data-bed="shade" aria-label="Rabata cienista"></button>
              <button class="bed bed-c" data-bed="terrace" aria-label="Rabata przy tarasie"></button>
            </div>

            <div class="canvas-help">Przeciągnij roślinę, aby zmienić jej pozycję · Delete usuwa zaznaczoną roślinę</div>
            <div class="canvas-legend">
              <span>● posadzone</span><span>○ planowane</span><span>↔ rozstaw</span>
            </div>
          </section>

          <section class="bottom-strip">
            <div class="metric"><strong>6</strong><span>rabat i sektorów</span></div>
            <div class="metric"><strong>56</strong><span>roślin w Twoim ogrodzie</span></div>
            <div class="metric"><strong>12</strong><span>pozycji do zakupu</span></div>
            <div class="metric"><strong>3</strong><span>kolizje do sprawdzenia</span></div>
          </section>
        </main>

        <aside class="sidebar right">
          <div class="section-kicker">Inspektor</div>
          <div class="panel-card">
            <div class="inspector-heading">
              <h3 data-inspector-title>Hortensja bukietowa</h3>
              <span class="badge" data-inspector-type>roślina</span>
            </div>
            <div class="property-row"><span>Status</span><strong>posadzona</strong></div>
            <div class="property-row"><span>Ekspozycja</span><strong>wschód</strong></div>
            <div class="property-row"><span>Rozstaw</span><strong>90 cm</strong></div>
            <div class="property-row"><span>Gleba</span><strong>próchniczna</strong></div>
          </div>

          <div class="panel-card">
            <h3>Analiza kompozycji</h3>
            <p>Pokrycie rabaty jest dobre, ale 3 rośliny naruszają docelowy rozstaw. Największe zagęszczenie występuje w centralnej części rabaty.</p>
            <div class="progress"><i></i></div>
            <div class="property-row"><span>Ocena układu</span><strong>74%</strong></div>
          </div>

          <div class="panel-card">
            <h3>Sezonowość</h3>
            <div class="property-row"><span>Wiosna</span><strong>68%</strong></div>
            <div class="property-row"><span>Lato</span><strong>92%</strong></div>
            <div class="property-row"><span>Jesień</span><strong>81%</strong></div>
            <div class="property-row"><span>Zima</span><strong>45%</strong></div>
          </div>

          <div class="panel-card">
            <h3>Do poprawy</h3>
            <p><span class="badge warn">3 kolizje</span></p>
            <p class="panel-note">Planner będzie tu wskazywał konflikty rozstawu, brakujące piętra kompozycji i luki sezonowe.</p>
          </div>
        </aside>
      </div>
    </div>

    <script>
      import '../scripts/moj-ogrod-planner';
    </script>
  </body>
</html>
