---
import '../styles/moj-ogrod-planner.scss';

const nav = [
  ['Plan ogrodu', 'aktywny'],
  ['Rabaty i sektory', '3'],
  ['Rośliny', '210'],
  ['Mój ogród', '56'],
  ['Zakupy', '12'],
  ['Studio', ''],
  ['Analiza', ''],
];

const libraryPlants = [
  { name:'Hortensja bukietowa', latin:'Hydrangea paniculata', spacing:90, height:180, spread:180, short:'H', seasons:'summer,autumn', bloom:'7,8,9,10', evergreen:'false', sun:'sun,partial', moisture:'normal,moist', ph:'acid,neutral,alkaline', soil:'żyzna, próchniczna i przepuszczalna' },
  { name:'Sosna bośniacka Compact Gem', latin:"Pinus heldreichii 'Compact Gem'", spacing:120, height:250, spread:200, short:'S', seasons:'spring,summer,autumn,winter', bloom:'', evergreen:'true', sun:'sun', moisture:'dry,normal', ph:'acid,neutral,alkaline', soil:'przepuszczalna; bez zastoin wody' },
  { name:'Paproć ogrodowa', latin:'Dryopteris', spacing:55, height:90, spread:75, short:'P', seasons:'spring,summer,autumn', bloom:'', evergreen:'false', sun:'shade,partial', moisture:'moist', ph:'acid,neutral,alkaline', soil:'próchniczna, stale lekko wilgotna' },
  { name:'Hakonechloa smukła', latin:'Hakonechloa macra', spacing:50, height:45, spread:50, short:'Ha', seasons:'summer,autumn,winter', bloom:'7,8', evergreen:'false', sun:'sun,partial,shade', moisture:'moist', ph:'acid,neutral,alkaline', soil:'próchniczna, żyzna i wilgotna' },
  { name:'Żurawka', latin:'Heuchera', spacing:35, height:35, spread:45, short:'Ż', seasons:'spring,summer,autumn,winter', bloom:'5,6,7', evergreen:'true', sun:'partial,shade', moisture:'normal,moist', ph:'acid,neutral', soil:'próchniczna i przepuszczalna' },
  { name:'Funkia', latin:'Hosta', spacing:60, height:60, spread:75, short:'F', seasons:'spring,summer,autumn', bloom:'7,8,9', evergreen:'false', sun:'partial,shade', moisture:'moist', ph:'acid,neutral,alkaline', soil:'żyzna, próchniczna i wilgotna' },
  { name:'Rozplenica japońska', latin:'Pennisetum alopecuroides', spacing:70, height:90, spread:120, short:'R', seasons:'summer,autumn,winter', bloom:'8,9,10', evergreen:'false', sun:'sun', moisture:'dry,normal', ph:'neutral,alkaline', soil:'przepuszczalna, umiarkowanie żyzna' },
  { name:'Tawułka Arendsa', latin:'Astilbe × arendsii', spacing:45, height:75, spread:60, short:'T', seasons:'summer', bloom:'7,8,9,10', evergreen:'false', sun:'partial,shade', moisture:'moist', ph:'acid,neutral', soil:'żyzna, próchniczna i wilgotna' },
];
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Mój Ogród — Planner Pro</title>
    <meta name="description" content="Desktopowy planer ogrodu: rabaty, rośliny, wymagania stanowiskowe, rozstaw, sezonowość i analiza kompozycji." />
  </head>
  <body>
    <div class="planner-shell">
      <header class="planner-topbar">
        <div class="brand-block">
          <div class="brand-mark">MO</div>
          <div class="brand-copy"><strong>Mój Ogród</strong><span>Planner Pro</span></div>
        </div>
        <div class="project-title">
          <span class="status-dot"></span>
          <strong>Ogród domowy · Rzeszów</strong>
          <span class="badge" data-save-badge>zapisano</span>
        </div>
        <div class="top-actions">
          <button class="icon-btn" title="Przywróć projekt" data-reset-project>↺</button>
          <button class="ghost-btn" data-import-project>Import JSON</button>
          <input type="file" accept=".json,application/json" hidden data-import-input />
          <button class="primary-btn" data-export-project>Eksport JSON</button>
        </div>
      </header>

      <div class="planner-body">
        <aside class="sidebar left">
          <div class="section-kicker">Projekt</div>
          {nav.slice(0, 4).map(([label, count], i) => (
            <button class:list={['nav-item', { active: i === 0 }]}>
              <span>{label}</span>{count && <small>{count}</small>}
            </button>
          ))}

          <div class="section-kicker">Planowanie</div>
          {nav.slice(4).map(([label, count]) => (
            <button class="nav-item"><span>{label}</span>{count && <small>{count}</small>}</button>
          ))}

          <div class="section-kicker">Biblioteka roślin</div>
          <label class="library-search">
            <span>⌕</span>
            <input type="search" placeholder="Szukaj rośliny…" data-library-search />
          </label>

          <label class="compatibility-filter">
            <input type="checkbox" data-compatible-filter />
            <span data-compatible-filter-label>Wybierz rabatę, aby filtrować</span>
            <small data-compatible-filter-count>8/8</small>
          </label>

          <div class="plant-library">
            {libraryPlants.map((plant) => (
              <button
                class="library-item"
                data-library-item
                data-library-name={plant.name}
                data-library-latin={plant.latin}
                data-library-spacing={plant.spacing}
                data-library-height={plant.height}
                data-library-spread={plant.spread}
                data-library-bloom={plant.bloom}
                data-library-evergreen={plant.evergreen}
                data-library-short={plant.short}
                data-library-seasons={plant.seasons}
                data-library-sun={plant.sun}
                data-library-moisture={plant.moisture}
                data-library-ph={plant.ph}
                data-library-soil={plant.soil}
              >
                <span class="library-avatar">{plant.short}</span>
                <span class="library-copy">
                  <strong>{plant.name}</strong>
                  <small>{plant.latin} · {plant.spacing} cm</small>
                </span>
                <span class="library-fit" data-library-fit>—</span>
                <span class="library-add">＋</span>
              </button>
            ))}
          </div>

          <div class="section-kicker">Warstwy</div>
          <button class="nav-item"><span>Rośliny poza rabatą</span><small data-outside-count>0</small></button>
          <button class="nav-item"><span>Niedopasowane do stanowiska</span><small data-mismatch-count>0</small></button>
          <button class="nav-item"><span>Snap do siatki</span><small data-snap-state>10 px</small></button>
        </aside>

        <main class="workspace">
          <div class="workspace-toolbar">
            <div class="tool-group">
              <button class="ghost-btn compact" title="Cofnij (Ctrl+Z)" data-undo disabled>↶</button>
              <button class="ghost-btn compact" title="Ponów (Ctrl+Shift+Z)" data-redo disabled>↷</button>
              <span class="toolbar-divider"></span>
              <button class="ghost-btn active-tool">Wybierz</button>
              <button class="ghost-btn" data-add-bed>Dodaj rabatę</button>
              <button class="ghost-btn" data-add-plant>Dodaj roślinę</button>
              <button class="ghost-btn" data-toggle-snap>Snap: ON</button>
              <button class="ghost-btn" data-auto-layout>Auto-layout smart</button>
            </div>
            <div class="tool-group">
              <button class="ghost-btn compact" data-zoom-out>−</button>
              <button class="ghost-btn" data-zoom-reset data-zoom-label>100%</button>
              <button class="ghost-btn compact" data-zoom-in>+</button>
              <button class="ghost-btn" data-fit>Dopasuj</button>
            </div>
          </div>

          <section class="simulation-bar">
            <div class="simulation-growth">
              <strong>Symulacja wzrostu</strong>
              <input type="range" min="1" max="5" step="1" value="3" data-growth-year />
              <span class="badge" data-growth-label>rok 3/5</span>
            </div>
            <div class="simulation-months" aria-label="Miesiąc symulacji">
              <button class="month-chip active" data-month="0">Cały rok</button>
              {['I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII'].map((month, index) => (
                <button class="month-chip" data-month={index + 1}>{month}</button>
              ))}
            </div>
          </section>

          <section class="canvas" aria-label="Plan ogrodu">
            <div class="planner-scene" data-planner-scene>
              <div class="garden-boundary"></div>
            </div>
            <div class="canvas-help">Zaznacz roślinę, aby zobaczyć halo rozstawu · Auto-layout uwzględnia stanowisko · Delete usuwa</div>
            <div class="canvas-legend">
              <span><i class="legend-dot planted"></i>pasuje</span>
              <span><i class="legend-dot mismatch"></i>stanowisko</span>
              <span><i class="legend-dot collision"></i>kolizja</span>
              <span><i class="legend-dot outside"></i>poza rabatą</span>
            </div>
          </section>

          <section class="bottom-strip">
            <div class="metric"><strong data-kpi-beds>3</strong><span>rabaty i sektory</span></div>
            <div class="metric"><strong data-kpi-plants>6</strong><span>roślin w projekcie</span></div>
            <div class="metric"><strong data-kpi-coverage>0%</strong><span>średnie pokrycie rabat</span></div>
            <div class="metric"><strong data-kpi-mismatch>0</strong><span>źle dobrane stanowisko</span></div>
            <div class="metric"><strong data-kpi-collisions>0</strong><span>roślin w kolizji</span></div>
          </section>
        </main>

        <aside class="sidebar right">
          <div class="section-kicker">Inspektor</div>

          <div class="panel-card">
            <div class="inspector-heading">
              <h3 data-inspector-title>Hortensja bukietowa</h3>
              <span class="badge" data-inspector-type>roślina</span>
            </div>
            <div class="property-row"><span>Przynależność</span><strong data-inspector-bed>—</strong></div>
            <div class="property-row"><span>Pozycja</span><strong data-inspector-position>—</strong></div>
            <div class="property-row"><span>Rozstaw</span><strong data-inspector-spacing>—</strong></div>
            <div class="property-row"><span>Szerokość docelowa</span><strong data-inspector-spread>—</strong></div>
            <div class="property-row"><span>Wysokość docelowa</span><strong data-inspector-height>—</strong></div>
          </div>

          <div class="panel-card" data-plant-requirements>
            <h3>Wymagania rośliny</h3>
            <div class="property-row"><span>Światło</span><strong data-plant-sun>—</strong></div>
            <div class="property-row"><span>Wilgotność</span><strong data-plant-moisture>—</strong></div>
            <div class="property-row"><span>Odczyn</span><strong data-plant-ph>—</strong></div>
            <div class="property-row"><span>Ziemia</span><strong class="property-long" data-plant-soil>—</strong></div>
            <div class="compatibility-status" data-plant-fit>Wybierz roślinę w rabacie.</div>
            <div class="quick-actions">
              <button class="ghost-btn" data-move-best-bed>Najlepsza rabata</button>
              <button class="ghost-btn" data-fix-spacing>Wolne miejsce</button>
            </div>
          </div>

          <div class="panel-card">
            <div class="inspector-heading">
              <h3>Warunki stanowiska</h3>
              <span class="badge" data-site-context>brak rabaty</span>
            </div>
            <label class="field-row">
              <span>Światło</span>
              <select data-bed-sun disabled>
                <option value="sun">Pełne słońce</option>
                <option value="partial">Półcień</option>
                <option value="shade">Cień</option>
              </select>
            </label>
            <label class="field-row">
              <span>Wilgotność</span>
              <select data-bed-moisture disabled>
                <option value="dry">Sucha</option>
                <option value="normal">Umiarkowana</option>
                <option value="moist">Wilgotna</option>
              </select>
            </label>
            <label class="field-row">
              <span>Odczyn gleby</span>
              <select data-bed-ph disabled>
                <option value="acid">Kwaśny</option>
                <option value="neutral">Obojętny</option>
                <option value="alkaline">Zasadowy</option>
              </select>
            </label>
            <label class="field-row">
              <span>Front rabaty</span>
              <select data-bed-front disabled>
                <option value="bottom">Dół planu</option>
                <option value="top">Góra planu</option>
                <option value="left">Lewa strona</option>
                <option value="right">Prawa strona</option>
              </select>
            </label>
            <p class="panel-note">Zmiana warunków natychmiast przelicza dobór roślin w tej rabacie.</p>
          </div>

          <div class="panel-card">
            <h3>Analiza rabaty</h3>
            <div class="property-row"><span>Pokrycie</span><strong data-bed-coverage>—</strong></div>
            <div class="property-row"><span>Dopasowanie roślin</span><strong data-bed-fit>—</strong></div>
            <div class="property-row"><span>Niskie piętro</span><strong data-layer-low>—</strong></div>
            <div class="property-row"><span>Średnie piętro</span><strong data-layer-mid>—</strong></div>
            <div class="property-row"><span>Wysokie piętro</span><strong data-layer-high>—</strong></div>
          </div>

          <div class="panel-card">
            <h3>Kompozycja 2.0</h3>
            <div class="property-row"><span>Warstwowanie</span><strong data-composition-layering>—</strong></div>
            <div class="property-row"><span>Rytm / powtórzenia</span><strong data-composition-rhythm>—</strong></div>
            <div class="property-row"><span>Ciągłość kwitnienia</span><strong data-composition-bloom>—</strong></div>
            <div class="property-row"><span>Dominanta</span><strong class="property-long" data-composition-dominant>—</strong></div>
            <p class="panel-note" data-composition-note>Wybierz rabatę, aby przeanalizować strukturę nasadzeń.</p>
          </div>

          <div class="panel-card">
            <h3>Kalendarz kwitnienia</h3>
            <div class="bloom-calendar" data-bloom-calendar>
              {['I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII'].map((month, index) => (
                <div class="bloom-month" data-bloom-month={index + 1}>
                  <span>{month}</span><i></i>
                </div>
              ))}
            </div>
          </div>

          <div class="panel-card">
            <h3>Sezonowość</h3>
            <div class="season-row"><span>Wiosna</span><div class="mini-progress"><i data-season-spring></i></div><strong data-season-spring-label>0%</strong></div>
            <div class="season-row"><span>Lato</span><div class="mini-progress"><i data-season-summer></i></div><strong data-season-summer-label>0%</strong></div>
            <div class="season-row"><span>Jesień</span><div class="mini-progress"><i data-season-autumn></i></div><strong data-season-autumn-label>0%</strong></div>
            <div class="season-row"><span>Zima</span><div class="mini-progress"><i data-season-winter></i></div><strong data-season-winter-label>0%</strong></div>
          </div>

          <div class="panel-card">
            <h3>Analiza kompozycji</h3>
            <p data-analysis-copy>Analiza jest liczona z aktualnego układu.</p>
            <div class="progress"><i data-analysis-progress></i></div>
            <div class="property-row"><span>Ocena układu</span><strong data-analysis-score>100%</strong></div>
          </div>

          <div class="panel-card">
            <h3>Do poprawy</h3>
            <p><span class="badge warn" data-collision-badge>0 problemów</span></p>
            <p class="panel-note" data-collision-note>Brak konfliktów.</p>
          </div>
        </aside>
      </div>
    </div>

    <script>
      import '../scripts/moj-ogrod-planner';
    </script>
  </body>
</html>
